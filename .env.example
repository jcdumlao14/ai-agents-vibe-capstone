# Example environment variables

APP_NAME=BusinessPilot AI
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

OPENAI_API_KEY=your-openai-api-key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
PROJECT_ID=your-gcp-project-id
GOOGLE_REGION=us-central1
GOOGLE_ADK_ENDPOINT_ID=projects/your-gcp-project-id/locations/us-central1/endpoints/1234567890
USE_GOOGLE_ADK=True
GOOGLE_ANTIGRAVITY_ENDPOINT=https://antigravity.googleapis.com/v1/analysis
GOOGLE_ANTIGRAVITY_API_KEY=your-antigravity-api-key
USE_GOOGLE_ANTIGRAVITY=True
DATASET_NAME=churn_dataset
MODEL_NAME=churn_model
